class Cache <TKey , TValue> {
 private Dictionary <TKey , (TValue value , DateTime? expiary) > _data 
   = new Dictionary <TKey , (TValue , DateTime?) > ();

public void Add (TKey key , TValue value , int? SecodsToExpire = null){
   DateTime? expiary = null;
   if (SecondsToExpire.HasValue)
      expiary = DateTime.Now.AddSeconds(SecodsToExpire.Value);
   _data [key] = (value , expiary);
}

public TValue Get (TKey key) {
  if (!_data.ContainsKey(key))
     return default(TValue);
  var item = _data[key];
  if (item.expiary.HasValue && item.expiary < DateTime.Now){
     _data.Remove(key);
    return default(TValue);
  }
  return item.value;
}

public bool Contains (TKey key){
  return Get(key) != null; 
}

public void Remove (TKey key){
  _data.Remove(key);
}









