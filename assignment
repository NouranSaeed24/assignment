2\ class Container<T> 
{
private List <T> _lists;
void Add (T values){
  _lists.Add(values);
}
List <T> Get() => _lists;
}



3\ هو ارسال متغيرات من انواع مختلفه ل type 
class Pair<TKey, TValue> {
TKey Key {get; set;}
TValue Value {get; set;}
public Pair (TKey key, TValue value){
  Key = key;
  Value = value;
}


4\ هى ميثود تستقبل نوع بيانات غير محدد فى وقت كتابه الكود
 ثم عند استخدام الميثود تقوم بتبديل placeholder بالنوع المراد عمل obj منه
class swapping{
public Swap <T> (T first , T second){
  T temp = first;
  first = second ;
  second = temp;
}
}



5\ public FindMax<T> (T[] arr){
      T max = arr[0];
      foreach (T item in arr)
          if( item.CompareTo(max) > 0)
              max = item;
   }







